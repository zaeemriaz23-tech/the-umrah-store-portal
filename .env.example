# Copy to .env for local development. Never commit .env.
PORT=3000

# Where local files live. With MySQL configured this is only a cache/recovery folder: uploaded files are mirrored into MySQL.
DATA_DIR=./data

# Admin password used ONLY when the admin account does not exist yet (login: admin). An existing admin password is never changed by a restart or redeploy.
ADMIN_PASSWORD=
# Emergency only: force-reset the admin password to ADMIN_PASSWORD on next start, then REMOVE this line.
RESET_ADMIN=

# Public site URL (canonical links, sitemap, Open Graph, e-mail links). Example: https://portal.theumrahstore.com
PUBLIC_URL=

# Optional integrations (can also be set in the CRM under Settings)
SERPAPI_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# --- MySQL primary storage -------------------------------------------------------------
# Set ALL FOUR of DB_HOST, DB_NAME, DB_USER, DB_PASSWORD (a partial set stops the app on purpose).
# Leave them commented out for local development: the CRM then uses DATA_DIR/db.json.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=0
# DB_POOL_SIZE=5

# Production safety switch: refuse to start on temporary JSON storage if the DB_* variables are missing.
# Recommended once MySQL is configured, so a typo can never silently start a blank CRM.
# REQUIRE_MYSQL=1

# Automatic restore points (kept in MySQL table crm_state_backups)
# DB_BACKUP_INTERVAL_MS=21600000   # at most one scheduled restore point per 6 hours (minimum 1 hour)
# DB_BACKUP_KEEP=30                # scheduled restore points kept
# DB_BACKUP_DAILY_KEEP=90          # daily restore points kept
# Restore points taken before upgrades, before restores and by hand are never pruned automatically.

# --- Automatic Meezab inventory sync (read-only) -------------------------------------------
# MEEZAB_API_URL=https://crm.meezabgroup.com/UMR/GetUmrGroupViewData
# MEEZAB_USERNAME=            # our authorised supplier account (server only, never shown to agents)
# MEEZAB_PASSWORD=
# MEEZAB_LOGIN_PATH=/login    # supplier sign-in page path; set MEEZAB_LOGIN_USER_FIELD / MEEZAB_LOGIN_PASS_FIELD if auto-detection fails
# MEEZAB_SECRET_KEY=          # encrypts a pasted session cookie at rest
# MEEZAB_FIELD_MAP={"oid":"GroupOid","gcode":"GroupCode","pcode":"PackageCode","seats":"AvailableSeats"}   # only if the API uses other field names
# MEEZAB_PAGE_PARAM=page      # pagination is followed automatically when the response reports more pages
